# Copy to .env for local-only development. These values are fake and not deployment credentials.
APP_NAME=Devopshere API
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+psycopg://devopshere:local-only-password@localhost:5432/devopshere
APP_REDIS_URL=redis://localhost:6379/0
APP_CACHE_TTL_SECONDS=30

POSTGRES_USER=devopshere
POSTGRES_PASSWORD=local-only-password
POSTGRES_DB=devopshere
